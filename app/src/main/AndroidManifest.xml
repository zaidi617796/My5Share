<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MyFiveShare: asal data usage parhne ke liye Usage Access (special permission, Settings se milti hai) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Auto-sync (Supabase) ke liye internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Minutes ginne ke liye call record, SMS ginne ke liye SMS — dono runtime par mangi jati hain.
         Note: Play Store par ye dono restricted permissions hain; listing ke waqt declaration lagegi. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Phone Settings Guide ka koi permission nahi chahiye tha: dialer/sms/settings sab intent se khulte hain -->

    <application
        android:allowBackup="true"
        android:label="MyFiveShare"
        android:theme="@style/Theme.SettingsGuide">

        <!-- Samne MyFiveShare khulega (Zahid, 2026-10-28).
             Apna theme: NoActionBar — upar wala duplicate title bar khatam. -->
        <activity
            android:name="com.myfiveshare.app.MfsActivity"
            android:theme="@style/Theme.MyFiveShare"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone Settings Guide: code maujood hai lekin filhal samne nahi (launcher nahi) -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".OperatorDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CodesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>
</manifest>
